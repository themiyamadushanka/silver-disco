{
  "name": "signbridge-ai-fullstack",
  "version": "1.0.0",
  "description": "Next.js (JS) frontend with MediaPipe Hand Tracking & FastAPI backend",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
